# Live PDRN refresh settings (used by scripts/pdrn_from_sap.py, 1 PM and 5 PM).
# Copy this file to  pdrn.env  in the same folder and fill in your SAP login.
# pdrn.env is git-ignored: git pull never changes it and it is never pushed to GitHub.

# SAP Production login (the same ID / password you use to open the /sap/zpdrn link)
VG_PDRN_USER=
VG_PDRN_PASSWORD=

# ----- optional (leave as is) -----
# VG_PDRN_URL=https://vhsmwps4ci.sap.smartworlddevelopers.com:20400/sap/zpdrn
# VG_PDRN_CLIENT=
# VG_PDRN_BUKRS=1010,1070,2010,2070,3070
# VG_PDRN_WERKS=1011,1013,1070,1072,2010,2071,3072,3073
#   (VG_PDRN_WERKS=* -> every project of those companies, new launches appear automatically)
# VG_PDRN_STATUS=all
# VG_PDRN_TIMEOUT=1800
# VG_PDRN_MIN_RATIO=0.9
